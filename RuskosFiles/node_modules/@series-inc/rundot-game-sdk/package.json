{
  "name": "@series-inc/rundot-game-sdk",
  "version": "5.27.0",
  "description": "RUN.world SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/series-ai/venus.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/rundot-game-api/index.d.ts",
      "import": "./dist/rundot-game-api/index.js",
      "default": "./dist/rundot-game-api/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js",
      "default": "./dist/vite/index.js"
    },
    "./playground": {
      "types": "./dist/playground/index.d.ts",
      "import": "./dist/playground/index.js",
      "default": "./dist/playground/index.js"
    },
    "./sandbox": {
      "types": "./dist/playground/index.d.ts",
      "import": "./dist/playground/index.js",
      "default": "./dist/playground/index.js"
    },
    "./webview": {
      "types": "./dist/webview/index.d.ts",
      "import": "./dist/webview/index.js",
      "default": "./dist/webview/index.js"
    },
    "./shared-assets": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mp-server": {
      "types": "./dist/mp-server/index.d.ts",
      "import": "./dist/mp-server/index.js",
      "default": "./dist/mp-server/index.js"
    },
    "./mp-client": {
      "types": "./dist/mp-client/index.d.ts",
      "import": "./dist/mp-client/index.js",
      "default": "./dist/mp-client/index.js"
    },
    "./host-http": {
      "types": "./dist/host-http.d.ts",
      "import": "./dist/host-http.js",
      "default": "./dist/host-http.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "scripts/install-hint.mjs",
    "scripts/setup.mjs",
    "scripts/copy-docs.mjs"
  ],
  "scripts": {
    "postinstall": "node scripts/install-hint.mjs",
    "prepack": "node scripts/copy-docs.mjs",
    "typecheck": "tsc --noEmit --watch --preserveWatchOutput",
    "typecheck:ci": "tsc --noEmit",
    "build": "npm run build:sdk && npm run build:vite && npm run build:mp-server",
    "build:mp-server": "tsup --config tsup.mp-server.config.ts",
    "build:sdk": "tsup --config tsup.config.ts && npm run verify:production-consumer",
    "verify:production-consumer": "node scripts/verify-production-consumer.mjs",
    "build:vite": "tsup --config tsup.vite.config.ts",
    "generate:embedded-three-exports": "node scripts/generate-embedded-three-exports.mjs",
    "pack": "npm pack",
    "pack:dry-run": "npm pack --dry-run",
    "test": "jest",
    "build:test-app": "npm run build --prefix tests/test-app",
    "verify:syncplay-test-app": "npm run verify:syncplay --prefix tests/test-app --",
    "dev": "tsup --watch",
    "generate:embedded-react-exports": "node scripts/generate-embedded-react-exports.mjs",
    "generate:embedded-inkjs-exports": "node scripts/generate-embedded-inkjs-exports.mjs",
    "generate:embedded-zustand-exports": "node scripts/generate-embedded-zustand-exports.mjs"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "keywords": [
    "RUN.world",
    "sdk",
    "api",
    "h5",
    "games"
  ],
  "dependencies": {
    "glin-profanity": "2.3.8",
    "qrcode": "^1.5.4",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.0.0",
    "concurrently": "^9.2.1",
    "firebase": "^12.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^6.0.0"
  },
  "bin": {
    "rundot-sdk-setup": "scripts/setup.mjs"
  }
}
